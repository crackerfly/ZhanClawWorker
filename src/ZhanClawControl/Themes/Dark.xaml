<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      品牌色 #024AD8 在深色背景上对比度不足（约 2.6:1），
      深色主题使用同色相提亮版本以满足可读性；品牌标识本身仍是 #024AD8。
    -->
    <SolidColorBrush x:Key="BrandBrush" Color="#3D7BEA" />
    <SolidColorBrush x:Key="BrandHoverBrush" Color="#5590F0" />
    <SolidColorBrush x:Key="BrandPressedBrush" Color="#2F66C9" />
    <SolidColorBrush x:Key="BrandSubtleBrush" Color="#1B2A47" />
    <SolidColorBrush x:Key="OnBrandBrush" Color="#FFFFFF" />

    <!-- Windows 原生深色语义 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#272727" />
    <SolidColorBrush x:Key="NavBackgroundBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#4A4A4A" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5C5C5" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#7A7A7A" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FCE100" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF99A4" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#FFB3BB" />

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#333333" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#3D3D3D" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#464646" />

</ResourceDictionary>
