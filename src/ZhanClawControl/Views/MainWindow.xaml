<Window x:Class="ZhanClawControl.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ZhanClawControl.Views"
        Title="{Binding WindowTitle}"
        Height="720" Width="1120" MinHeight="600" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource NavBackgroundBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,24,18,18">
                    <views:PhosphorIcon Width="28" Height="28"
                                           Primary="{x:Static views:PhosphorIcons.ShieldCheck}"
                                           Secondary="{x:Static views:PhosphorIcons.ShieldCheckSecondary}"
                                           Foreground="{DynamicResource BrandBrush}"
                                           AutomationProperties.Name="{DynamicResource ProductName}" />
                    <TextBlock Text="{DynamicResource ProductName}" FontWeight="SemiBold" FontSize="15"
                               TextWrapping="Wrap" LineHeight="21" Margin="0,12,0,0" />
                    <TextBlock Text="{DynamicResource Subtitle}" Style="{StaticResource CaptionText}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="20,12,18,18">
                    <TextBlock Style="{StaticResource CaptionText}" Text="{Binding TrayBackgroundStatus}" />
                </StackPanel>

                <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <views:PhosphorIcon Width="18" Height="18" Margin="0,0,10,0"
                                                       Primary="{Binding Primary}" Secondary="{Binding Secondary}"
                                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                                       AutomationProperties.Name="{Binding Title}" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
    </Grid>
</Window>
