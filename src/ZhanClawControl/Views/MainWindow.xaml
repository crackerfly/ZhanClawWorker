<Window x:Class="ZhanClawControl.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:ZhanClawControl.Services"
        Title="{x:Static svc:AppInfo.ProductName}"
        Height="720" Width="1120"
        MinHeight="600" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航 -->
        <Border Grid.Column="0" Background="{DynamicResource NavBackgroundBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!--
                  正式名称较长，图标单独占一行、名称整行换行显示，
                  避免在 248px 宽的导航栏内被裁切。
                -->
                <StackPanel DockPanel.Dock="Top" Margin="18,22,18,18">
                    <Border Width="30" Height="30" CornerRadius="7"
                            Background="{DynamicResource BrandBrush}" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{DynamicResource OnBrandBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{x:Static svc:AppInfo.ProductName}"
                               FontWeight="SemiBold" FontSize="14"
                               TextWrapping="Wrap" LineHeight="20"
                               Margin="0,12,0,0" />
                    <TextBlock Text="{x:Static svc:AppInfo.Subtitle}"
                               Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="18,12,18,16">
                    <TextBlock Style="{StaticResource CaptionText}"
                               Text="{Binding Status.RunningText, StringFormat=后台状态：{0}}" />
                </StackPanel>

                <ListBox ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavItem}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                           FontSize="15" VerticalAlignment="Center" Width="22" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 内容区 -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="0" />
    </Grid>
</Window>
