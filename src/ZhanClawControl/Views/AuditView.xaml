<UserControl x:Class="ZhanClawControl.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="220" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="{DynamicResource AuditTitle}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{DynamicResource AuditDescription}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource AuditFilter}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{DynamicResource AuditFilter}" />
                    <CheckBox Content="{DynamicResource AuditParseOnly}" IsChecked="{Binding ShowParseErrorsOnly}"
                              Margin="0,8,0,0" />
                </StackPanel>
                <WrapPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top">
                    <Button Content="{DynamicResource CommonRefresh}" Command="{Binding RefreshCommand}" Margin="0,0,8,8" />
                    <Button Content="{DynamicResource AuditCopyDiagnostics}" Style="{StaticResource AccentButton}"
                            Command="{Binding CopyDiagnosticsCommand}" Margin="0,0,8,8" />
                    <Button Content="{DynamicResource AuditSaveDiagnostics}" Command="{Binding SaveDiagnosticsCommand}" Margin="0,0,8,8" />
                    <Button Content="{DynamicResource AuditExport}" Command="{Binding ExportJournalCommand}" Margin="0,0,8,8" />
                    <Button Content="{DynamicResource AuditOpenFolder}" Command="{Binding OpenDataFolderCommand}" />
                </WrapPanel>
            </Grid>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <TextBlock Text="{Binding JournalSummary}" Style="{StaticResource CaptionText}" />
                    <TextBlock Text="{DynamicResource AuditJournalContractHelp}" Style="{StaticResource CaptionText}"
                               Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Records}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource ColumnTime}" Binding="{Binding TimestampText, Mode=OneWay}" Width="125" />
                        <DataGridTextColumn Header="{DynamicResource ColumnSource}" Binding="{Binding ShortSourcePeer, Mode=OneWay}" Width="140" />
                        <DataGridTextColumn Header="{DynamicResource ColumnAction}" Binding="{Binding Action, Mode=OneWay}" Width="150" />
                        <DataGridTextColumn Header="{DynamicResource ColumnState}" Binding="{Binding State, Mode=OneWay}" Width="105" />
                        <DataGridTextColumn Header="{DynamicResource ColumnResult}" Binding="{Binding Status, Mode=OneWay}" Width="90" />
                        <DataGridTextColumn Header="{DynamicResource ColumnAck}" Binding="{Binding AcknowledgedText, Mode=OneWay}" Width="65" />
                        <DataGridTextColumn Header="{DynamicResource ColumnDuration}" Binding="{Binding DurationText, Mode=OneWay}" Width="75" />
                        <DataGridTextColumn Header="{DynamicResource ColumnError}" Binding="{Binding Error, Mode=OneWay}" Width="160" />
                        <DataGridTextColumn Header="{DynamicResource ColumnParse}" Binding="{Binding ParseError, Mode=OneWay}" Width="120" />
                        <DataGridTextColumn Header="{DynamicResource ColumnCommandId}" Binding="{Binding ShortCommandId, Mode=OneWay}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="{DynamicResource AuditRuntimeLog}" Style="{StaticResource SectionTitle}" Margin="0" />
                <TextBlock Text="{DynamicResource AuditRuntimeLogHelp}" Style="{StaticResource CaptionText}" Margin="0,3,140,0" />
            </StackPanel>
            <Button Content="{DynamicResource AuditClearLog}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Command="{Binding ClearLogCommand}" />
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0" Padding="0">
            <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                     Background="Transparent" FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" Padding="14,12" VerticalContentAlignment="Top" MinHeight="0"
                     AutomationProperties.Name="{DynamicResource AuditRuntimeLog}" />
        </Border>
    </Grid>
</UserControl>
