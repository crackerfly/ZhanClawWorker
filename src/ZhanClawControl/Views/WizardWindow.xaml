<Window x:Class="ZhanClawControl.Views.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ZhanClawControl.Views"
        Title="{DynamicResource WizardTitle}" Height="680" Width="820" MinHeight="600" MinWidth="720"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Padding="30,24" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <views:PhosphorIcon Width="28" Height="28" Margin="0,1,14,0" VerticalAlignment="Top"
                                       Primary="{x:Static views:PhosphorIcons.ShieldCheck}"
                                       Secondary="{x:Static views:PhosphorIcons.ShieldCheckSecondary}"
                                       Foreground="{DynamicResource BrandBrush}" AutomationProperties.Name="{DynamicResource ProductName}" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource ProductName}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{DynamicResource WizardHeader}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30,26">
            <StackPanel>
                <TextBlock Text="{Binding StepTitle}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding StepCaption}" Style="{StaticResource CaptionText}" Margin="0,4,0,22" />

                <StackPanel Visibility="{Binding IsStep0, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SettingsAgentName}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding AgentName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"
                                     AutomationProperties.Name="{DynamicResource SettingsAgentName}" />
                            <TextBlock Text="{DynamicResource SettingsTags}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding AgentTags, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{DynamicResource SettingsTags}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource WizardPrivateNetworkKey}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{DynamicResource WizardPrivateNetworkHelp}" Style="{StaticResource CaptionText}" Margin="0,0,0,10" />
                            <Grid Visibility="{Binding HasEmbeddedSwarmKey, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <views:PhosphorIcon Width="18" Height="18" Margin="0,0,10,0"
                                                       Primary="{x:Static views:PhosphorIcons.CheckCircle}"
                                                       Secondary="{x:Static views:PhosphorIcons.CheckCircleSecondary}"
                                                       Foreground="{DynamicResource SuccessBrush}"
                                                       AutomationProperties.Name="{DynamicResource WizardKeyEmbedded}" />
                                <TextBlock Grid.Column="1" Text="{Binding SwarmKeyStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </Grid>
                            <StackPanel Visibility="{Binding NeedsSwarmKeySelection, Converter={StaticResource BoolToVisibility}}">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SwarmKeyPath, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{DynamicResource WizardPrivateNetworkKey}" />
                                    <Button Grid.Column="1" Content="{DynamicResource CommonBrowse}" Margin="8,0,0,0"
                                            Command="{Binding BrowseSwarmKeyCommand}" />
                                </Grid>
                                <TextBlock Text="{Binding SwarmKeyStatus}" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                            <TextBlock Text="{DynamicResource WizardNetworkDefaultHelp}" Style="{StaticResource CaptionText}"
                                       Margin="0,12,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource WizardRunAccount}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{DynamicResource WizardRunAccountHelp}" Style="{StaticResource CaptionText}" Margin="0,0,0,10" />
                            <TextBox Text="{Binding RunAsUser, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFontFamily}"
                                     AutomationProperties.Name="{DynamicResource WizardRunAccount}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource WizardControllerPeerId}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ControllerPeerId, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFontFamily}"
                                         AutomationProperties.Name="{DynamicResource WizardControllerPeerId}" />
                                <Button Grid.Column="1" Content="{DynamicResource CommonPaste}" Margin="8,0,0,0"
                                        Command="{Binding PastePeerIdCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding PeerIdHint}" Style="{StaticResource CaptionText}" Margin="0,0,0,12" />
                            <TextBlock Text="{DynamicResource AuthorizationNote}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding ControllerNote, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{DynamicResource AuthorizationNote}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <views:PhosphorIcon Width="20" Height="20" Margin="0,1,12,0" VerticalAlignment="Top"
                                                   Primary="{x:Static views:PhosphorIcons.ShieldCheck}"
                                                   Secondary="{x:Static views:PhosphorIcons.ShieldCheckSecondary}"
                                                   Foreground="{DynamicResource BrandBrush}"
                                                   AutomationProperties.Name="{DynamicResource WizardAuthorizationMeaning}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{DynamicResource WizardAuthorizationMeaning}" FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource WizardAuthorizationMeaningDetail}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource WizardSecurityOptions}" Style="{StaticResource SectionTitle}" />
                            <!-- CheckBox.IsChecked defaults to TwoWay. HardenAcl is a read-only
                                 status property, so the display binding must be explicitly OneWay. -->
                            <CheckBox IsChecked="{Binding HardenAcl, Mode=OneWay}" IsEnabled="False"
                                      Content="{DynamicResource WizardHardenAcl}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <views:PhosphorIcon Width="20" Height="20" Margin="0,1,12,0" VerticalAlignment="Top"
                                                   Primary="{x:Static views:PhosphorIcons.Warning}"
                                                   Secondary="{x:Static views:PhosphorIcons.WarningSecondary}"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   AutomationProperties.Name="{DynamicResource SettingsRuntimeRiskTitle}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{DynamicResource SettingsRuntimeRiskTitle}" FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource SettingsRuntimeRiskHelp}" Style="{StaticResource CaptionText}"
                                           Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource WizardProgress}" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding Steps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <views:PhosphorIcon Width="18" Height="18" Margin="0,1,8,0" VerticalAlignment="Top"
                                                                   Foreground="{Binding Success, Converter={StaticResource BoolToStatusBrush}}"
                                                                   AutomationProperties.Name="{Binding Title}">
                                                <views:PhosphorIcon.Style>
                                                    <Style TargetType="views:PhosphorIcon">
                                                        <Setter Property="Primary" Value="{x:Static views:PhosphorIcons.XCircle}" />
                                                        <Setter Property="Secondary" Value="{x:Static views:PhosphorIcons.XCircleSecondary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Success}" Value="True">
                                                                <Setter Property="Primary" Value="{x:Static views:PhosphorIcons.CheckCircle}" />
                                                                <Setter Property="Secondary" Value="{x:Static views:PhosphorIcons.CheckCircleSecondary}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </views:PhosphorIcon.Style>
                                            </views:PhosphorIcon>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                                                <TextBlock Text="{DynamicResource InstallTechnicalDetail}"
                                                           Style="{StaticResource CaptionText}" Margin="0,8,0,3"
                                                           Visibility="{Binding Success, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                                <TextBox Text="{Binding TechnicalDetail, Mode=OneWay}"
                                                         IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                                         TextWrapping="Wrap" MaxHeight="120" MinHeight="0"
                                                         VerticalContentAlignment="Top"
                                                         VerticalScrollBarVisibility="Auto"
                                                         FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                                         Visibility="{Binding Success, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{DynamicResource WizardInstalling}" Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                                       Visibility="{Binding Installing, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding CompletionMessage}" Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                                       Visibility="{Binding CompletionMessage, Converter={StaticResource StringNotEmptyToVisibility}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="30,16">
            <Grid>
                <Button Content="{DynamicResource WizardBack}" HorizontalAlignment="Left" Command="{Binding BackCommand}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource WizardNext}" Style="{StaticResource AccentButton}"
                            Command="{Binding NextCommand}" Margin="0,0,8,0"
                            Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    <Button Content="{DynamicResource WizardInstall}" Style="{StaticResource AccentButton}"
                            Command="{Binding InstallCommand}" Margin="0,0,8,0"
                            Visibility="{Binding ShowInstallButton, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{DynamicResource WizardRetry}" Style="{StaticResource AccentButton}"
                            Command="{Binding RetryCommand}" Margin="0,0,8,0"
                            Visibility="{Binding ShowRetryButton, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{DynamicResource WizardFinish}" Command="{Binding FinishCommand}"
                            Visibility="{Binding Finished, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
