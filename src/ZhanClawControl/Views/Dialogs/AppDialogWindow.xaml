<Window x:Class="ZhanClawControl.Views.Dialogs.AppDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ZhanClawControl.Views"
        Width="560" MinWidth="420" MaxWidth="680" MaxHeight="720"
        SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        ShowActivated="True"
        AutomationProperties.LiveSetting="Assertive"
        KeyboardNavigation.TabNavigation="Cycle">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="24,24,24,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="IconContainer"
                    Width="40" Height="40" Margin="0,0,16,0"
                    VerticalAlignment="Top"
                    Background="{DynamicResource SurfaceAltBrush}"
                    CornerRadius="20">
                <views:PhosphorIcon x:Name="SemanticIcon"
                                       Width="24" Height="24"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="HeadingText"
                           Margin="0,0,0,8"
                           FontSize="16" FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <!-- Read-only TextBox keeps long diagnostics selectable/copyable while
                     retaining the existing typography and high-contrast theme tokens. -->
                <TextBox x:Name="MessageText" Grid.Row="1"
                         MaxHeight="360" MinHeight="0"
                         VerticalContentAlignment="Top"
                         Padding="0" BorderThickness="0"
                         Background="Transparent"
                         IsReadOnly="True" IsReadOnlyCaretVisible="True"
                         TextWrapping="Wrap" AcceptsReturn="False"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         FocusVisualStyle="{StaticResource KeyboardFocusVisual}"
                         AutomationProperties.LiveSetting="Assertive" />
            </Grid>
        </Grid>

        <Border Grid.Row="1"
                Padding="24,16"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0">
            <WrapPanel x:Name="ActionPanel"
                       Orientation="Horizontal"
                       HorizontalAlignment="Right" />
        </Border>
    </Grid>
</Window>
