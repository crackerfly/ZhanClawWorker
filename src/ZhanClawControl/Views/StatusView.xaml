<UserControl x:Class="ZhanClawControl.Views.StatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
        <StackPanel>

            <TextBlock Text="状态" Style="{StaticResource PageTitle}" Margin="0,0,0,4" />
            <TextBlock Text="本机作为被控端接入 P2P 网络的实时情况。" Style="{StaticResource CaptionText}" Margin="0,0,0,18" />

            <!-- 总览 -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="12" Height="12" VerticalAlignment="Top" Margin="0,6,14,0"
                             Fill="{Binding AgentRunning, Converter={StaticResource BoolToStatusBrush}}" />

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding StatusHeadline}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,10,0,0"
                                   Text="{Binding BusyMessage}"
                                   Visibility="{Binding BusyMessage, Converter={StaticResource StringNotEmptyToVisibility}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="启动" Style="{StaticResource AccentButton}"
                                Command="{Binding StartCommand}" Margin="0,0,8,0" />
                        <Button Content="停止" Command="{Binding StopCommand}" Margin="0,0,8,0" />
                        <Button Content="重启" Command="{Binding RestartCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 授权提示 -->
            <Border Style="{StaticResource Card}"
                    Visibility="{Binding ShowNoAuthorizationWarning, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Top" Margin="0,2,12,0" />
                    <StackPanel>
                        <TextBlock Text="当前未授权任何主控设备" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                   Text="这是安全的默认状态，不是故障。本机可以联网并被发现，但会拒绝所有远端任务。到「授权管理」添加主控设备的 PeerID 后才能接受任务。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 本机身份 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="本机身份" Style="{StaticResource SectionTitle}" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PeerID" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding PeerId, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas, Cascadia Mono, Courier New" />
                        <Button Grid.Column="2" Content="复制" Margin="8,0,0,0" MinWidth="72"
                                Command="{Binding CopyPeerIdCommand}" />
                    </Grid>

                    <TextBlock Style="{StaticResource CaptionText}" Margin="120,0,0,12"
                               Text="把 PeerID 交给主控端管理员，对方需要把它加入自己的设备列表。" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Agent 版本" Style="{StaticResource CaptionText}" />
                        <TextBlock Grid.Column="1" Text="{Binding AgentVersion}" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="开机任务" Style="{StaticResource CaptionText}" />
                        <TextBlock Grid.Column="1" Text="{Binding TaskStateText}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="远端授权" Style="{StaticResource CaptionText}" />
                        <TextBlock Grid.Column="1" Text="{Binding AuthorizationSummary}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 当前连接 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="当前连接的设备" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,12"
                               Text="仅显示当前建立了连接的 Peer。完全离线的设备不会出现在这里，这不代表对方已被移除。" />

                    <DataGrid ItemsSource="{Binding ConnectedPeers}" MaxHeight="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PeerID" Binding="{Binding ShortPeerId}" Width="200" />
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="连接路径" Binding="{Binding ConnectionPath}" Width="220" />
                            <DataGridTextColumn Header="范围" Binding="{Binding Scope}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
