<UserControl x:Class="ZhanClawControl.Views.StatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ZhanClawControl.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28">
        <StackPanel MaxWidth="920" HorizontalAlignment="Stretch">
            <TextBlock Text="{DynamicResource StatusTitle}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{DynamicResource StatusDescription}" Style="{StaticResource CaptionText}"
                       Margin="0,4,0,22" />

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="10" Height="10" VerticalAlignment="Top" Margin="0,6,14,0"
                             Fill="{Binding AgentRunning, Converter={StaticResource BoolToStatusBrush}}" />
                    <StackPanel Grid.Column="1" Margin="0,0,18,0">
                        <TextBlock Text="{Binding StatusHeadline}" FontSize="16" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource CaptionText}" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding BusyMessage}" Style="{StaticResource CaptionText}" Margin="0,10,0,0"
                                   Visibility="{Binding BusyMessage, Converter={StaticResource StringNotEmptyToVisibility}}" />
                    </StackPanel>
                    <WrapPanel Grid.Column="2" VerticalAlignment="Top">
                        <Button Content="{DynamicResource CommonStart}" Style="{StaticResource AccentButton}"
                                Command="{Binding StartCommand}" Margin="0,0,8,8" />
                        <Button Content="{DynamicResource CommonStop}" Command="{Binding StopCommand}" Margin="0,0,8,8" />
                        <Button Content="{DynamicResource CommonRestart}" Command="{Binding RestartCommand}" />
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}"
                    Visibility="{Binding ShowDeploymentWarning, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <views:PhosphorIcon Width="20" Height="20" Margin="0,1,12,0" VerticalAlignment="Top"
                                           Primary="{x:Static views:PhosphorIcons.Warning}"
                                           Secondary="{x:Static views:PhosphorIcons.WarningSecondary}"
                                           Foreground="{DynamicResource WarningBrush}"
                                           AutomationProperties.Name="{DynamicResource StatusDeploymentMismatch}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{DynamicResource StatusDeploymentMismatch}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DeploymentIssues}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                        <TextBlock Text="{DynamicResource StatusRepairDescription}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                        <Button Content="{DynamicResource StatusRepair}" Style="{StaticResource AccentButton}"
                                HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding RepairCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}"
                    Visibility="{Binding ShowNoAuthorizationWarning, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <views:PhosphorIcon Width="20" Height="20" Margin="0,1,12,0" VerticalAlignment="Top"
                                           Primary="{x:Static views:PhosphorIcons.Warning}"
                                           Secondary="{x:Static views:PhosphorIcons.WarningSecondary}"
                                           Foreground="{DynamicResource WarningBrush}"
                                           AutomationProperties.Name="{DynamicResource StatusNoAuthorizationTitle}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{DynamicResource StatusNoAuthorizationTitle}" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource StatusNoAuthorizationDetail}" Style="{StaticResource CaptionText}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource StatusIdentity}" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource StatusPeerId}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding PeerId, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Cascadia Mono, Consolas"
                                 AutomationProperties.Name="{DynamicResource StatusPeerId}" />
                        <Button Grid.Column="2" Content="{DynamicResource CommonCopy}" Margin="8,0,0,0"
                                Command="{Binding CopyPeerIdCommand}" />
                    </Grid>
                    <TextBlock Text="{DynamicResource StatusPeerIdHelp}" Style="{StaticResource CaptionText}"
                               Margin="150,0,0,14" />
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource StatusAgentVersion}" Style="{StaticResource CaptionText}" />
                        <TextBlock Grid.Column="1" Text="{Binding AgentVersion}" />
                    </Grid>
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource StatusLoginTask}" Style="{StaticResource CaptionText}" />
                        <TextBlock Grid.Column="1" Text="{Binding TaskStateText}" TextWrapping="Wrap" />
                    </Grid>
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource StatusConfiguredAuthorization}" Style="{StaticResource CaptionText}" />
                        <TextBlock Grid.Column="1" Text="{Binding ConfiguredAuthorizationSummary}" TextWrapping="Wrap" />
                    </Grid>
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource StatusEffectiveAuthorization}" Style="{StaticResource CaptionText}" />
                        <TextBlock Grid.Column="1" Text="{Binding EffectiveAuthorizationSummary}" TextWrapping="Wrap" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource StatusConnectivity}" Style="{StaticResource CaptionText}" />
                        <TextBlock Grid.Column="1" Text="{Binding ConnectivitySummary}" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource StatusConnections}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{DynamicResource StatusConnectionsHelp}" Style="{StaticResource CaptionText}"
                               Margin="0,0,0,12" />
                    <DataGrid ItemsSource="{Binding ConnectedPeers}" MaxHeight="240">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource ColumnPeerId}" Binding="{Binding ShortPeerId}" Width="190" />
                            <DataGridTextColumn Header="{DynamicResource ColumnName}" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="{DynamicResource ColumnPath}" Binding="{Binding ConnectionPath}" Width="200" />
                            <DataGridTextColumn Header="{DynamicResource ColumnScope}" Binding="{Binding Scope}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
