<UserControl x:Class="ZhanClawControl.Views.AuthorizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ZhanClawControl.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28">
        <StackPanel MaxWidth="920" HorizontalAlignment="Stretch">
            <TextBlock Text="{DynamicResource AuthorizationTitle}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{DynamicResource AuthorizationDescription}" Style="{StaticResource CaptionText}"
                       Margin="0,4,0,22" />

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <views:PhosphorIcon Width="20" Height="20" Margin="0,1,12,0" VerticalAlignment="Top"
                                           Primary="{x:Static views:PhosphorIcons.ShieldCheck}"
                                           Secondary="{x:Static views:PhosphorIcons.ShieldCheckSecondary}"
                                           Foreground="{DynamicResource BrandBrush}"
                                           AutomationProperties.Name="{DynamicResource AuthorizationBehaviorTitle}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{DynamicResource AuthorizationBehaviorTitle}" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource AuthorizationBehaviorDetail}" Style="{StaticResource CaptionText}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource AuthorizationAddTitle}" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NewPeerId, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Cascadia Mono, Consolas"
                                 AutomationProperties.Name="{DynamicResource WizardControllerPeerId}" />
                        <Button Grid.Column="1" Content="{DynamicResource CommonPaste}" Margin="8,0,0,0"
                                Command="{Binding PasteCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding NewPeerIdHint}" Style="{StaticResource CaptionText}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NewNote, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{DynamicResource AuthorizationNote}" />
                        <Button Grid.Column="1" Content="{DynamicResource AuthorizationAdd}"
                                Style="{StaticResource AccentButton}" Margin="8,0,0,0" Command="{Binding AddCommand}" />
                    </Grid>
                    <TextBlock Text="{DynamicResource AuthorizationNote}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource AuthorizationListTitle}" Style="{StaticResource SectionTitle}" Margin="0" />
                        <WrapPanel Grid.Column="1">
                            <Button Content="{DynamicResource AuthorizationRemove}" Command="{Binding RemoveCommand}" Margin="0,0,8,8" />
                            <Button Content="{DynamicResource AuthorizationSaveApply}" Style="{StaticResource AccentButton}"
                                    Command="{Binding SaveCommand}" />
                        </WrapPanel>
                    </Grid>
                    <Border Background="{DynamicResource BrandSubtleBrush}" CornerRadius="6" Padding="12,10"
                            Margin="0,0,0,10"
                            Visibility="{Binding PendingRestart, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{DynamicResource AuthorizationPending}" Style="{StaticResource CaptionText}" />
                    </Border>
                    <Border Background="{DynamicResource BrandSubtleBrush}" CornerRadius="6" Padding="12,10"
                            Margin="0,0,0,10"
                            Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{DynamicResource AuthorizationUnsaved}" Style="{StaticResource CaptionText}" />
                    </Border>
                    <TextBlock Text="{DynamicResource AuthorizationEmpty}" Style="{StaticResource CaptionText}"
                               Margin="0,0,0,10" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                    <DataGrid ItemsSource="{Binding Peers}" SelectedItem="{Binding Selected, Mode=TwoWay}" MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource ColumnNote}" Binding="{Binding Note}" Width="190" />
                            <DataGridTextColumn Header="{DynamicResource ColumnPeerId}" Binding="{Binding ShortPeerId}" Width="*" />
                            <DataGridTextColumn Header="{DynamicResource ColumnConnection}" Binding="{Binding OnlineText}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource AuthorizationEmergencyTitle}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{DynamicResource AuthorizationEmergencyDetail}" Style="{StaticResource CaptionText}"
                               Margin="0,0,0,12" />
                    <WrapPanel>
                        <Button Content="{DynamicResource AuthorizationRevokeAll}" Style="{StaticResource DangerButton}"
                                Command="{Binding RevokeAllCommand}" Margin="0,0,8,8" />
                        <Button Content="{DynamicResource AuthorizationRestore}" Command="{Binding RestoreBackupCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
